# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
RUN find /lib /usr/lib -maxdepth 1 -name '*.so*' | sed 's,.*/,,' | LC_ALL=C sort -u > /tmp/base-sonames; \
    apk add --no-cache \
      build-base \
      curl \
      xz

ARG VERSION
ARG SOURCE_SHA256
# The source tarball has no top-level directory.
RUN printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]{2}' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    printf '%s\n' "${SOURCE_SHA256}" | grep -Eqx '[0-9a-f]{64}' \
      || { echo "SOURCE_SHA256 must be the tarball's sha256" >&2; exit 1; }; \
    url="https://github.com/ip7z/7zip/releases/download/${VERSION}/7z$(printf '%s' "${VERSION}" | tr -d .)-src.tar.xz"; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o /tmp/7zip.tar.xz "$url"; \
    echo "${SOURCE_SHA256}  /tmp/7zip.tar.xz" | sha256sum -c -; \
    mkdir /src; \
    tar -xJf /tmp/7zip.tar.xz -C /src; \
    rm /tmp/7zip.tar.xz; \
    echo "$url" > /tmp/source-url

# 7zz is the standalone console build, with every format and codec compiled
# in. cmpl_gcc.mak builds the C and C++ code only: the x86-64 assembler code
# needs asmc or UASM, which the distro does not package. Upstream compiles
# with -Werror, so a new warning from a newer GCC would stop the build.
# musl declares cpu_set_t and the thread affinity calls only with _GNU_SOURCE.
ARG JOBS
WORKDIR /src/CPP/7zip/Bundles/Alone2
RUN mkdir -p b/g; \
    make -j"${JOBS:-$(nproc)}" -f ../../cmpl_gcc.mak \
      CC='gcc -D_GNU_SOURCE' \
      CXX='g++ -D_GNU_SOURCE' \
      CFLAGS_WARN_WALL='-Wall -Wextra' \
      | tee /tmp/make.log

COPY runtime-deps.alpine /tmp/runtime-deps.extra
RUN install -D -m 755 b/g/7zz /out/usr/local/bin/7zz; \
    ln -s 7zz /out/usr/local/bin/7z; \
    /out/usr/local/bin/7zz i > /tmp/7zz-info; \
    grep -Fq "7-Zip (z) ${VERSION} (" /tmp/7zz-info; \
    grep -Eq ' Rar5$' /tmp/7zz-info; \
    meta=/out/usr/local/share/randomcontainers/7zip; \
    mkdir -p "$meta/licenses"; \
    cp /src/DOC/License.txt /src/DOC/copying.txt /src/DOC/unRarLicense.txt "$meta/licenses/"; \
    echo "${VERSION}" > "$meta/version"; \
    cp /tmp/source-url "$meta/source"; \
    { \
      echo "source-sha256=${SOURCE_SHA256}"; \
      echo "compile=$(grep -m 1 -F ' -c ' /tmp/make.log)"; \
      echo "compiler=$(cc --version | sed -n 1p)"; \
    } > "$meta/buildinfo"; \
    export LC_ALL=C; \
    readelf -d /out/usr/local/bin/7zz | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p' > /tmp/needed; \
    test -s /tmp/needed; \
    while read -r so; do \
      if grep -qxF "$so" /tmp/base-sonames; then continue; fi; \
      echo "so:$so"; \
    done < /tmp/needed > /tmp/runtime-deps.elf; \
    test -s /tmp/runtime-deps.elf; \
    cat /tmp/runtime-deps.elf /tmp/runtime-deps.extra | sort -u > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
RUN --mount=type=bind,from=build,source=/out/usr/local/share/randomcontainers/7zip/runtime-deps,target=/tmp/runtime-deps \
    set -eu; \
    xargs apk add --no-cache ca-certificates tini < /tmp/runtime-deps; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
COPY --link --from=build /out/usr/local/ /usr/local/
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "7zz"]
CMD ["--help"]
